 }
 
 /* TEST (iav/droid RE session): optional overrides with the vendor-exact
@@ -24,6 +29,7 @@ emit_raw(struct util_dynarray *regs, uint32_t target, uint32_t reg,
  * MR !42134 byte-exact diff table.  Enabled with RKT_VENDOR_OVR=1.
