index 083fbae91cf..ca0ec8cd832 100644
--- a/src/gallium/drivers/rocket/rkt_ml.c
+++ b/src/gallium/drivers/rocket/rkt_ml.c
@@ -373,13 +373,16 @@ lower_fully_connected(struct rkt_ml_subgraph *subgraph,
